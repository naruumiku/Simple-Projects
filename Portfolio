<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>My Portfolio</title>

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

<style>

/* GENERAL */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:"Times New Roman",Arial,sans-serif
}

html{scroll-behavior:smooth}

body{
    background:linear-gradient(120deg,#000,#101010 15%,#202020 30%,#3a3a3a 45%,#4a4a4a 50%,#343434 58%,#1b1b1b 75%,#080808 90%,#000);
    background-attachment:fixed;
    color:#eee;
    line-height:1.5
}


/* HEADER */

header,footer{
    background:linear-gradient(100deg,#000,#151515,#303030,#171717,#000);
    border-color:#555;
    box-shadow:0 5px 25px #000c
}

header{
    padding:15px 8%;
    display:flex;
    justify-content:space-between;
    align-items:center;
    border-bottom:2px solid #555;
    position:sticky;
    top:0;
    z-index:100
}

header h1,nav a,.input h2 span,.skill-logo,
.facebook-card,.profile-box,.profile-image,
.about-card,.skill-card,.project-card,
.contact-card,.contact-card p,.contact-card i{
    transition:.3s
}

header h1:hover{
    transform:scale(1.05);
    text-shadow:0 0 15px #fff6
}


/* NAVIGATION */

nav a{
    color:#bbb;
    text-decoration:none;
    margin-left:20px;
    display:inline-block
}

nav a:hover{
    color:#fff;
    transform:translateY(-3px) scale(1.05);
    text-shadow:0 0 10px #fff8
}


/* HOME */

.input{
    min-height:500px;
    padding:80px 8%;
    display:flex;
    align-items:center
}

.input-content{
    width:100%;
    display:grid;
    grid-template-columns:1fr 300px;
    gap:100px;
    align-items:center
}

.input-text{
    padding-left:10%;
    text-align:left
}

.input h2{
    font-size:40px;
    margin-bottom:10px
}

.input h2 span{
    color:#fff;
    display:inline-block
}

.input h2 span:hover{
    transform:scale(1.05);
    text-shadow:0 0 15px #fff8
}

.input p{color:#c0c0c0}


/* FACEBOOK CARD */

.facebook-card{
    margin-top:12px;
    padding:9px 12px;
    max-width:280px;
    display:flex;
    align-items:center;
    gap:10px;
    background:linear-gradient(135deg,#111,#303030,#151515);
    border:1px solid #555;
    border-radius:8px;
    box-shadow:0 3px 12px #0009;
    text-decoration:none;
    color:inherit
}

.facebook-card:hover{
    transform:translateY(-4px) scale(1.02);
    border-color:#888;
    box-shadow:0 8px 20px #000e
}

.facebook-icon{
    font-size:27px;
    margin-right:5px
}

.facebook-card h3{font-size:16px}

.facebook-card p,
.facebook-visit{
    font-size:11px
}

.facebook-card p{margin-bottom:3px}

.facebook-visit{color:#fff}

.facebook-card:hover .facebook-icon{
    transform:scale(1.15) rotate(5deg);
    color:#fff
}

.facebook-card:hover .facebook-visit{
    text-decoration:underline
}


/* PROFILE */

.profile-box{
    width:300px;
    height:300px;
    display:flex;
    justify-content:center;
    align-items:center;
    justify-self:end;
    border-radius:20px;
    background:linear-gradient(135deg,#050505,#252525,#444,#202020,#050505);
    border:1px solid #555;
    box-shadow:0 0 35px #000e,inset 0 0 25px #fff1
}

.profile-box:hover{
    transform:translateY(-5px);
    box-shadow:0 15px 45px #000e,0 0 30px #fff2
}

.profile-image{
    width:230px;
    height:260px;
    object-fit:cover;
    border-radius:8px;
    border:3px solid #555;
    box-shadow:0 5px 20px #000c
}

.profile-image:hover{
    transform:scale(1.08) translateY(-8px) rotate(2deg);
    border-color:#999;
    box-shadow:0 15px 35px #000e,0 0 25px #fff2
}


/* SECTIONS */

section{padding:80px 8%}

h2{
    text-align:center;
    margin-bottom:25px
}


/* CARDS */

.about-card,
.skill-card,
.project-card,
.contact-card{
    background:linear-gradient(135deg,#111,#303030,#151515);
    border:1px solid #555;
    box-shadow:0 5px 20px #0009
}

.about-card,
.contact-card{
    margin:auto;
    text-align:center;
    border-radius:15px
}

.about-card{
    max-width:750px;
    padding:30px
}

.about-card p{color:#c0c0c0}

.about-card:hover,
.skill-card:hover,
.project-card:hover,
.contact-card:hover{
    transform:translateY(-8px) scale(1.02);
    border-color:#888;
    box-shadow:0 15px 40px #000e
}


/* SKILLS + PROJECTS */

.project-skill-content{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:100px
}

.skill-card{
    padding:18px;
    margin-bottom:15px;
    display:flex;
    align-items:center;
    border-radius:12px;
    cursor:pointer;
    color:#ccc
}

.skill-card:hover,
.project-card:hover{
    background:linear-gradient(135deg,#1c1c1c,#444,#181818)
}


/* SKILLS */

.skill-logo{
    font-size:42px;
    width:60px;
    margin-right:15px
}

.skill-card:hover .skill-logo{
    transform:scale(1.15) rotate(5deg)
}

.html{color:#e98b72}
.css{color:#5b9dcc}
.java{color:#e5a85b}
.python{color:#5f91c5}
.csharp{color:#8c78b8}


/* PROJECTS */

.project-card{
    padding:20px;
    margin-bottom:15px;
    border-radius:12px;
    cursor:pointer
}

.project-card h3{
    margin-bottom:8px;
    transition:.3s
}

.project-card:hover h3{
    transform:translateX(5px);
    text-shadow:0 0 10px #fff5
}

.project-card p{color:#aaa}


/* CONTACT */

.contact-card{
    max-width:600px;
    padding:30px
}

.contact-card p{
    margin:15px 0;
    color:#c0c0c0
}

.contact-card p:hover{
    transform:scale(1.03);
    color:#fff
}

.contact-card i{
    margin-right:8px
}

.contact-card p:hover i{
    transform:scale(1.2) rotate(5deg);
    color:#fff
}


/* FOOTER */

footer{
    padding:25px;
    text-align:center;
    border-top:2px solid #555;
    color:#aaa
}


/* MOBILE */

@media(max-width:700px){

    header{
        flex-direction:column;
        gap:15px
    }

    nav a{margin:0 8px}

    .input{
        min-height:500px;
        padding:80px 10%
    }

    .input-content,
    .project-skill-content{
        grid-template-columns:1fr
    }

    .input-content{gap:30px}

    .project-skill-content{gap:40px}

    .input-text{
        padding-left:0;
        text-align:center
    }

    .input h2{
        font-size:30px;
        text-align:center
    }

    .input p{text-align:center}

    .facebook-card{
        margin-left:auto;
        margin-right:auto
    }

    .profile-box{
        width:230px;
        height:250px;
        justify-self:center
    }

    .profile-image{
        width:180px;
        height:210px
    }

}

</style>

</head>


