<!DOCTYPE html>
<html lang="en">
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Portfolio</title>

  <style>
    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
      font-family:Times New Roman, Ariel;
    }

    body{
      background:#000;
      color:#fff;
      line-height:1.8;
    

    header{
      background:#111;
      padding:10px 10%;
      display:flex;
      justify-content:space-between;
      align-items:center;
      border-bottom:1px solid #333;
    }

    header h1{
      color:#fff;
    }

    nav a{
      color:#ddd;
      text-decoration:none;
      margin-left:20px;
      transition:.3s;
    }

    .input{
      text-align:center;
      padding:75px 20px;
    }

    .input h2{
      font-size:60px;
      margin-bottom: 0; 
    }

    .input span{
      color:#fff;
    }

    .input space{
      margin:10px auto;
      max-width:600px;
      color:#fff;
    }
     #about h2 {
      margin-bottom: 0;
    }

    section{
      padding:70px 10%;
    }

    h2{
      text-align:center;
      margin-bottom:30px;
      color:#fff;
    }


  </style>
</head>

<body>

<header>
  <h1>MyPortfolio</h1>

  <nav>
    <a href="#about">About</a>
  </nav>
</header>


<section class="input">

  <h2>Hello, I'm <span>Bench Bacquian</span></h2>

  <p>
    A passionate student and aspiring web developer who enjoys creating
    beautiful and functional websites.
  </p>


</section>


<section id="about">

  <h2>About Me</h2>

  <p style="text-align:center; max-width:750px; margin:auto; color:#fff;">
    I'm currently learning HTML, Java, CSS, and hopefully Python as my next language.
    I enjoy improving my programming skills every day.
  </p>

</section>


</body>
</html>
